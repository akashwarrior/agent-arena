// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Agent {
  id     String @id @default(uuid())
  name   String @unique
  color  String
  accent String

  participants GameParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum GameStatus {
  DRAFT
  UPCOMING
  LIVE
  ENDED
  CANCELLED
  SETTLED
}

enum GameParticipantStatus {
  ACTIVE
  ELIMINATED
  WINNER
  LOSER
}

enum BetStatus {
  ACTIVE
  WON
  LOST
  REFUNDED
}

enum SolanaNetwork {
  DEVNET
  MAINNET
}

enum EscrowAccountStatus {
  ACTIVE
  DISABLED
  RETIRED
}

enum PaymentType {
  BET_DEPOSIT
  PAYOUT
  REFUND
  PLATFORM_FEE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  CONFIRMED
  FAILED
  EXPIRED
  CANCELLED
}

enum SettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SettlementEntryType {
  PAYOUT
  REFUND
  LOSS
  PLATFORM_FEE
}

enum SettlementEntryStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Game {
  id     Int        @id @default(autoincrement())
  name   String
  status GameStatus @default(UPCOMING)

  escrowAccountId String
  escrowAccount   EscrowAccount @relation(fields: [escrowAccountId], references: [id])

  feeBps Int @default(0)

  startedAt   DateTime?
  endedAt     DateTime?
  settledAt   DateTime?
  cancelledAt DateTime?

  totalPool BigInt  @default(0)
  feeAmount BigInt?

  winnerParticipantId String?
  winnerParticipant   GameParticipant? @relation("GameWinner", fields: [winnerParticipantId, id], references: [id, gameId])

  participants GameParticipant[] @relation("GameParticipants")
  payments     Payment[]
  settlement   GameSettlement?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([winnerParticipantId, id])
}

model GameParticipant {
  id String @id @default(uuid())

  gameId Int
  game   Game @relation("GameParticipants", fields: [gameId], references: [id], onDelete: Cascade)

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id])

  status GameParticipantStatus @default(ACTIVE)

  position     Int?
  finalRank    Int?
  finalScore   Float?
  eliminatedAt DateTime?

  wonGame           Game?             @relation("GameWinner")
  bets              Bet[]
  payments          Payment[]
  wonSettlements    GameSettlement[]  @relation("SettlementWinner")
  settlementEntries SettlementEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gameId, agentId])
  @@unique([id, gameId])
}

model EscrowAccount {
  id String @id @default(uuid())

  network SolanaNetwork

  publicKey         String
  tokenAccount      String
  usdcMintAddress   String
  usdcDecimals      Int    @default(6)
  status            EscrowAccountStatus @default(ACTIVE)

  games    Game[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([network, publicKey])
  @@unique([network, tokenAccount])
  @@unique([network, usdcMintAddress, publicKey])
}

model Bet {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  gameId            Int
  gameParticipantId String
  gameParticipant   GameParticipant @relation(fields: [gameParticipantId, gameId], references: [id, gameId])

  depositPaymentId String
  depositPayment   Payment @relation("BetDepositPayment", fields: [depositPaymentId, gameId], references: [id, gameId])

  amount       BigInt
  payoutAmount BigInt?
  status       BetStatus @default(ACTIVE)

  placedAt  DateTime  @default(now())
  settledAt DateTime?

  payments          Payment[]         @relation("BetPayments")
  settlementEntries SettlementEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, gameParticipantId])
  @@unique([depositPaymentId, gameId])
  @@unique([id, gameId])
}

model Payment {
  id String @id @default(uuid())

  type   PaymentType
  status PaymentStatus @default(PENDING)

  amount          BigInt
  confirmedAmount BigInt?

  fromAddress      String
  toAddress        String
  fromTokenAccount String?
  toTokenAccount   String?

  txHash        String?   @unique
  expiresAt     DateTime?
  confirmedAt   DateTime?
  failureReason String?
  verification  Json?

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  escrowAccountId String
  escrowAccount   EscrowAccount @relation(fields: [escrowAccountId], references: [id])

  gameId Int
  game   Game @relation(fields: [gameId], references: [id])

  gameParticipantId String?
  gameParticipant   GameParticipant? @relation(fields: [gameParticipantId, gameId], references: [id, gameId])

  betId String?
  bet   Bet?    @relation("BetPayments", fields: [betId, gameId], references: [id, gameId])

  depositBet Bet? @relation("BetDepositPayment")

  settlementEntryId String?
  settlementEntry   SettlementEntry? @relation(fields: [settlementEntryId, gameId], references: [id, gameId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, gameId])
}

model GameSettlement {
  id String @id @default(uuid())

  gameId Int  @unique
  game   Game @relation(fields: [gameId], references: [id])

  winningParticipantId String?
  winningParticipant   GameParticipant? @relation("SettlementWinner", fields: [winningParticipantId, gameId], references: [id, gameId])

  status SettlementStatus @default(PENDING)

  totalPool  BigInt
  feeAmount  BigInt
  payoutPool BigInt
  feeBps     Int

  error       String?
  completedAt DateTime?

  entries SettlementEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, gameId])
}

model SettlementEntry {
  id String @id @default(uuid())

  gameId Int

  settlementId String
  settlement   GameSettlement @relation(fields: [settlementId, gameId], references: [id, gameId], onDelete: Cascade)

  betId String?
  bet   Bet?    @relation(fields: [betId, gameId], references: [id, gameId])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  gameParticipantId String?
  gameParticipant   GameParticipant? @relation(fields: [gameParticipantId, gameId], references: [id, gameId])

  type   SettlementEntryType
  status SettlementEntryStatus @default(PENDING)

  amount        BigInt
  walletAddress String?
  failureReason String?
  completedAt   DateTime?

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, gameId])
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  bets              Bet[]
  payments          Payment[]
  settlementEntries SettlementEntry[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
